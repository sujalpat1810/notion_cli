{
  "name": "@sujalpat1810/notion-cli",
  "version": "0.1.0",
  "description": "Build Notion templates and dashboards from declarative YAML specs.",
  "type": "module",
  "license": "MIT",
  "repository": "github:sujalpat1810/notion_cli",
  "bin": {
    "notion-cli": "dist/cli.js",
    "ncli": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "schema"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live",
    "spike": "tsx scripts/spike/run.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@napi-rs/keyring": "^2.1.2",
    "@notionhq/client": "^5.30.0",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsdown": "^0.23.4",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0"
  }
}
